  "system_contract": {
    "continuity_fields": [
      "topic_value_id",
      "candidate_id"
    ],
    "identity_field": "entity_id",
    "optional_checkpoints": [
      "visual-qa",
      "first-comment"
    ],
    "required_checkpoints": [
      "surface-scouting",
      "consolidation",
      "topic-value",
      "writer",
      "narrative-editor",
      "critic",
      "deterministic-gates",
