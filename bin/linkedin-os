#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHON="$ROOT/.venv/bin/python"
else
  PYTHON="${PYTHON:-python3}"
fi

# Import the checked-in adapter directly; launching never installs dependencies.
PYTHONPATH="$ROOT/src:$ROOT/packages/workflow_beacon/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

if [ "${1:-}" = "discover" ]; then
  shift
  exec "$PYTHON" -m authority_os.beacon_integration discover code '
from authority_os import v1_gates
v1_gates.install()
from authority_os import v1_completion
v1_completion.install()
from authority_os import topic_value_id_contract
topic_value_id_contract.install()
from authority_os import daily_discovery_cli
raise SystemExit(daily_discovery_cli.main())
' "$@"
fi

if [ "${1:-}" = "media" ]; then
  shift
  exec "$PYTHON" -m authority_os.beacon_integration media module authority_os.media "$@"
fi

if [ "${1:-}" = "export-monitoring" ]; then
  shift
  exec "$PYTHON" -m authority_os.beacon_integration export-monitoring module authority_os.monitoring_export "$@"
fi

if [ "${1:-}" = "record-spine-performance" ]; then
  shift
  exec "$PYTHON" -m authority_os.beacon_integration record-spine-performance module authority_os.spine_feedback_io record "$@"
fi

if [ "${1:-}" = "spine-review" ]; then
  shift
  exec "$PYTHON" -m authority_os.beacon_integration spine-review module authority_os.spine_feedback_io review "$@"
fi

if [ "${1:-}" = "corrections" ]; then
  shift
  exec "$PYTHON" -m authority_os.beacon_integration corrections module authority_os.correction_context "$@"
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  "$PYTHON" -m authority_os.beacon_integration help module authority_os.integrated_cli "$@"
  STATUS=$?
  if [ "$STATUS" -eq 0 ]; then
    printf '\nV1 end-to-end workflow:\n'
    printf '  discover            Run parallel discovery; add --generate-post to continue through drafting.\n'
    printf '  export-monitoring   Export one redacted seven-check dashboard case for a completed run.\n'
    printf '  corrections         Review and approve project-specific corrections.\n'
  fi
  exit "$STATUS"
fi

MODULE="authority_os.integrated_cli"
for ARG in "$@"; do
  if [ "$ARG" = "--dry-run" ]; then
    MODULE="authority_os"
    break
  fi
done

if [ "$MODULE" = "authority_os" ]; then
  exec "$PYTHON" -m authority_os.beacon_integration "${1:-help}" module "$MODULE" "$@"
fi

exec "$PYTHON" -m authority_os.beacon_integration "${1:-help}" code '
import sys
from authority_os import v1_gates
v1_gates.install()
from authority_os import v1_completion
v1_completion.install()
from authority_os import topic_value_id_contract
topic_value_id_contract.install()
from authority_os import v1_length_policy
v1_length_policy.install()
from authority_os import single_topic_codex
single_topic_codex.install()
from authority_os import human_readability
human_readability.install()
from authority_os import critic_anchor_retry
critic_anchor_retry.install()
from authority_os import actionable_diagnostics
actionable_diagnostics.install()
from authority_os import social_media_gate_policy
social_media_gate_policy.install()
from authority_os import v1_consumability
v1_consumability.install()
if "--run-spec" not in sys.argv:
    from authority_os import v1_runtime_tuning
    v1_runtime_tuning.install()
from authority_os import quality_optimizer
quality_optimizer.install()
from authority_os import integrated_cli
quality_optimizer.wire_integrated_dispatch(integrated_cli)
from authority_os import standalone_draft_observability
raise SystemExit(standalone_draft_observability.run(integrated_cli.main, sys.argv[1:]))
' "$@"
