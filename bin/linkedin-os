#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHON="$ROOT/.venv/bin/python"
else
  PYTHON="${PYTHON:-python3}"
fi

if [ "${1:-}" = "discover" ]; then
  shift
  PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m authority_os.daily_cli "$@"
fi

MODULE="authority_os.integrated_cli"
for ARG in "$@"; do
  if [ "$ARG" = "--dry-run" ]; then
    # Preserve the complete deterministic fixture diagnostics used by public
    # smoke tests. High-bar and anti-slop suppression apply only to live drafting.
    MODULE="authority_os"
    break
  fi
done

PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m "$MODULE" "$@"
